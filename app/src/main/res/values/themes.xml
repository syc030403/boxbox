<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.Boxbox" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/f1_red</item>
        <item name="colorPrimaryVariant">@color/f1_black</item>
        <item name="colorOnPrimary">@color/f1_white</item>
        <item name="colorSecondary">@color/f1_black</item>
        <item name="android:statusBarColor" tools:targetApi="21">@color/f1_black</item>
    </style>

    <style name="ToolbarTitle.Boxbox" parent="TextAppearance.Widget.AppCompat.Toolbar.Title">
        <item name="android:fontFamily">@font/saira_condensed_black</item>
        <item name="android:textStyle">normal</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0.02</item>
        <item name="android:textSize">22sp</item>
        <item name="android:textColor">@color/f1_white</item>
    </style>

    <style name="TabText.Boxbox" parent="TextAppearance.Design.Tab">
        <item name="android:fontFamily">@font/saira_condensed_bold</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:letterSpacing">0.05</item>
        <item name="android:textSize">14sp</item>
    </style>
</resources>
