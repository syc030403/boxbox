<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="12dp"
    android:layout_marginVertical="6dp"
    android:background="@color/f1_gray"
    android:foreground="?attr/selectableItemBackground"
    android:clickable="true"
    android:focusable="true"
    android:padding="14dp">

    <View
        android:id="@+id/accentBar"
        android:layout_width="3dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/roundText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:fontFamily="@font/saira_condensed_bold"
        android:letterSpacing="0.06"
        android:textColor="@color/f1_red"
        android:textSize="13sp"
        app:layout_constraintStart_toEndOf="@id/accentBar"
        app:layout_constraintTop_toTopOf="parent"
        tools:text="ROUND 01" />

    <TextView
        android:id="@+id/statusText"
        android:layout_width="wrap_content"
        android:layout_height="20dp"
        android:background="@drawable/bg_team_chip"
        android:fontFamily="@font/saira_condensed_bold"
        android:gravity="center"
        android:letterSpacing="0.06"
        android:paddingHorizontal="8dp"
        android:textColor="@color/f1_white"
        android:textSize="11sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:text="예정" />

    <TextView
        android:id="@+id/raceNameText"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginTop="6dp"
        android:fontFamily="@font/saira_condensed_black"
        android:textColor="@color/f1_white"
        android:textSize="20sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/accentBar"
        app:layout_constraintTop_toBottomOf="@id/roundText"
        tools:text="Australian Grand Prix" />

    <TextView
        android:id="@+id/circuitNameText"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginTop="4dp"
        android:fontFamily="@font/saira_condensed_semibold"
        android:textColor="#B0B0B8"
        android:textSize="14sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/accentBar"
        app:layout_constraintTop_toBottomOf="@id/raceNameText"
        tools:text="Albert Park Grand Prix Circuit" />

    <TextView
        android:id="@+id/dateText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginTop="8dp"
        android:fontFamily="monospace"
        android:textColor="@color/f1_white"
        android:textSize="13sp"
        app:layout_constraintStart_toEndOf="@id/accentBar"
        app:layout_constraintTop_toBottomOf="@id/circuitNameText"
        tools:text="2026.03.08 (일) 14:00 KST" />

</androidx.constraintlayout.widget.ConstraintLayout>
